{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2024"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "strict": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "noEmit": true,
        "erasableSyntaxOnly": true
    },
    "include": [".vitepress/*.ts"]
}
