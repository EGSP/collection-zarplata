{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2024"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": "src"
    },
    "include": ["src/server", "src/configuration"],
    "exclude": ["node_modules", "dist", "repos", "src/web"]
}
