{
  "name": "collection-zarplata",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "typecheck": "npm run metadata:generate && node scripts/configuration-imports-check.ts && node scripts/documentation-check.ts && tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p docs/tsconfig.json && tsc --noEmit -p src/web/tsconfig.json",
    "diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
    "dev": "npm run metadata:generate && npm run build:server && npm run build:docs && concurrently --prefix-colors blue,green,magenta,yellow \"npm:dev:*\"",
    "dev:metadata": "node scripts/metadata-generate.ts --watch",
    "dev:build": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:server": "node --enable-source-maps --watch dist/server/main.js",
    "dev:web": "vite",
    "build": "npm run metadata:generate && npm run build:server && npm run build:web && npm run build:docs",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "build:docs": "vitepress build docs",
    "docs:dev": "vitepress dev docs --port 5174",
    "docs:check": "node scripts/documentation-check.ts",
    "build:executable": "npm run build && node scripts/build-executable.mjs",
    "metadata:generate": "node scripts/metadata-generate.ts",
    "start": "node --enable-source-maps dist/server/main.js",
    "start:check": "npm run build && node --enable-source-maps dist/server/main.js --database=memory"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.5",
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-fastify": "12.1.1",
    "@refinedev/core": "5.0.12",
    "@refinedev/react-router": "2.0.4",
    "@tanstack/react-hotkeys": "0.12.1",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-store": "0.11.2",
    "@tursodatabase/database": "0.8.0",
    "antd": "6.6.5",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "effect": "4.0.0-rc.118",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.46.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "mermaid": "11.17.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17"
  }
}
